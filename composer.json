{
  "name": "sports-league/app",
  "description": "Sports League Management Application",
  "type": "project",
  "require": {
    "php": ">=8.0",
    "mikecao/flight": "^3.0",
    "firebase/php-jwt": "^6.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "backend/"
    }
  },
  "scripts": {
    "start": "php -S 0.0.0.0:$PORT -t .",
    "dev": "php -S localhost:8000 -t ."
  },
  "config": {
    "platform": {
      "php": "8.0"
    }
  }
}
